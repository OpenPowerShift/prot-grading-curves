# Sample 02 — Simple single-relay study
#
# Industrial 480 V feeder with one OC element plus an instantaneous
# stage. Useful as a minimum working example when introducing the
# language.
#
# In the playground, press ? (or Ctrl-Space) for completions: on a blank
# line it lists what the enclosing block accepts, and after an `=` it
# lists that field's values -- curve names, quantities, declared
# conditions and voltage levels included.

meta {
  project = "Plant 480 V feeder";
  engineer = "B. Singh";
}

system {
  voltages {
    LV {
      V = 0.48 kV;
    }
  }
}

faults {
  BUS_FAULT {
    name = "Bus fault";
    I = 4500 A;
  } # bolted fault at end of feeder
}

relay R_FDR_480 {
  voltage = LV;
  ct_ratio = 600/5;

  element 51 {
    curve = ansi.mi;
    I_pickup = 600 A;
    tms = 2.00; # ANSI time dial: 0.5 .. 15
  }
}

page {
  # One relay needs little paper; A5 is a page in a report.
  size = "A5";
  theme = "light";
  title = "Plant 480 V — single-relay OC study";

  # One curve identifies itself. `style = none` drops the panel
  # altogether, which is what a figure in a report wants when the text
  # beside it already says which relay this is:
  #
  #   column   a panel down the right-hand gutter (the default)
  #   inside   the same panel, floated over a corner of the plot
  #   direct   no panel; each curve labelled where it runs
  #   none     no identification at all
  #
  # Sample 11 shows `direct`, which is the one to reach for when there
  # are several curves and the gutter is worth reclaiming.
  legend = {
    style = "none";
  };
}
