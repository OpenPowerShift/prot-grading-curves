# Sample 08 — Fuse / relay coordination
#
# A 100 A expulsion fuse on a spur, backed by the feeder relay. The
# fuse is not one curve but a *band*: it may begin to melt anywhere
# above its minimum-melt characteristic and is guaranteed clear by its
# total-clear characteristic. Coordination is judged against the
# *total-clear* boundary — the relay must still be holding when the
# fuse has finished clearing.
#
# Manufacturer data is entered as (current, time) tables; fuse curves
# are published, not computed, so no IDMT formula applies.
#
# In the playground, press ? (or Ctrl-Space) for completions: on a blank
# line it lists what the enclosing block accepts, and after an `=` it
# lists that field's values -- curve names, quantities, declared
# conditions and voltage levels included.

meta {
  project = "Spur fuse coordination";
  engineer = "B. Singh";
  date = "2026-07-28";
  margin = 0.15 s; # typical fuse-relay CTI
}

system {
  voltages {
    MV {
      V = 11.0 kV;
    }
  }
}

faults {
  SPUR_FAULT {
    name = "Spur fault";
    I = 900 A;
  }
  BUS_FAULT {
    name = "Bus fault";
    I = 4200 A;
  }
}

device fuse_100T {
  voltage = MV; # the level it sits on
  kind = "fuse";
  maker = "Mersen";
  model = "100T";
  rating_I = 100 A;

  min_melt    = [(200 A, 60 s), (300 A, 9.0 s), (600 A, 0.60 s),
  (1200 A, 0.10 s), (3000 A, 0.016 s)];
  total_clear = [(200 A, 105 s), (300 A, 15.0 s), (600 A, 1.00 s),
  (1200 A, 0.17 s), (3000 A, 0.028 s)];
}

relay R_FEEDER {
  voltage = MV;
  maker = "SEL";
  model = "SEL-751";
  ct_ratio = 400/5;

  element 51 {
    function = "phase_oc";
    curve = iec.vi;
    I_pickup = 200 A;
    tms = 0.35;
  }
}

grade {
  primary = fuse_100T; # fuse clears first
  backup = R_FEEDER:51;
  fault = SPUR_FAULT;
  margin = 0.15 s;
}

page {
  size = "Letter";
  orientation = "landscape";
  theme = "light";
  border = true;
  title       = {
    text = "11 kV spur — fuse / relay coordination";
    subtitle = "Mersen 100T against an SEL-751 feeder element";
  };
}

view {
  current_pad = 0.25;
}
