# Sample 16 — House drawing style: every knob on the `page` block
#
# The electrical content here is deliberately thin — two relays and a
# fault. What this sheet is *for* is the `page` block: paper size and
# orientation, theme, margins, the legend's placement and swatch, axis
# and grid inks, the curve palette, how marked points and leaders are
# drawn, the title block, the footer macros, and a watermark.
#
# Most drawing offices have one house style and set it once. Copy this
# block into a study, change the strings, and every sheet matches.
#
# Press ? inside any sub-block for the fields it takes, and after an
# `=` for that field's values — the list is scoped, so `style` inside
# `legend` offers layouts and inside `leaders` offers line/arrow/dot.

meta {
  project = "Netherfield BSP";
  study = "Drawing standard sheet";
  engineer = "M. Haugen";
  date = "2026-08-01";
  revision = "D";
  client = "Northern Networks"; # any extra key is carried through
  drawing = "NF-TCC-0014"; # and readable by a [meta.*] macro
  margin = 0.30 s;
}

system {
  voltages {
    MV {
      V = 11.0 kV;
      description = "11 kV switchboard";
    }
  }
}

faults {
  BOARD_MAX {
    name = "Board max";
    I = 12.5 kA;
    type = three_phase;
    voltage = MV;
  }
  BOARD_MIN {
    name = "Board min";
    I = 3.1 kA;
    type = two_phase;
    voltage = MV;
  }
}

times {
  SWITCHGEAR_RATING {
    name = "Switchgear rating";
    t = 1 s;
    at_I = 8 kA;
    description = "1 s short-time withstand";
  }
}

relay R_FDR {
  name = "Feeder";
  maker = "Siemens";
  model = "7SJ82";
  voltage = MV;
  ct_ratio = 800/5;

  # The curve this sheet is *about*, drawn heavier than its context.
  # `width_px` overrides page { curves { line_width_px } } for this one
  # characteristic; `color` and `style` override the palette the same
  # way. On a grayscale sheet that is often the only way to say which
  # line is the subject.
  element 51 {
    function = "phase_oc";
    curve = iec.si;
    I_pickup = 960 A;
    tms = 0.12;
    I_cutoff = 12.5 kA;
    width_px = 2.8;
  }
}

relay R_INC {
  name = "Incomer";
  maker = "Siemens";
  model = "7SJ85";
  voltage = MV;
  ct_ratio = 1600/5;

  element 51 {
    function = "phase_oc";
    curve = iec.si;
    I_pickup = 1.8 kA;
    tms = 0.30;
    I_cutoff = 12.5 kA;
  }

  # A breaker-fail stage: fixed delay, started by the same pickup.
  #
  # Context rather than argument, so it is subdued deliberately: its
  # own ink and a dotted stroke keep it legible without competing with
  # the two curves the grading turns on. The palette slot it would have
  # taken is still consumed, so naming a colour here does not shuffle
  # the hues of everything after it.
  element 50BF {
    name = "Breaker fail";
    function = "breaker_fail";
    curve = definite;
    I_pickup = 1.8 kA;
    t_delay = 250 ms;
    color = "#8a8983";
    style = dotted;
    width_px = 1.4;
  }
}

grade {
  primary = R_FDR:51;
  backup = R_INC:51;
  fault = BOARD_MAX;
  margin = 0.30 s;
}

annotate {
  primary = R_FDR:51;
  backup = R_INC:51;
  fault = BOARD_MAX;
  label = "CTI";
}

point RATING_CORNER {
  name = "Rating corner";
  I = 8 kA;
  t = 1 s;
  label = "Switchgear 1 s rating";
  shape = circle;
}

# ---- The house style. ------------------------------------------------
page {
  # Paper. `stretch` fills the viewport rather than keeping the
  # sheet's own aspect ratio.
  size = "Tabloid";
  orientation = "landscape";
  stretch = false;
  border = true;

  # Monochrome prints legibly on a plan copier and survives a fax.
  theme = "monochrome";

  margins_mm  = {
    top = 14;
    right = 12;
    bottom = 16;
    left = 18;
  };

  # Where the identification goes, and what shape the swatch is.
  legend = {
    show = true;
    style = "inside"; # floated over the plot, not a gutter
    position = "top_left";
    title = "Protection";
    color = "#222222";
    swatch = "circle";
    currents = "both"; # primary and secondary amps
    notes = true; # the tool's account of what it could not draw

    # The office's own standing text, under its own heading. `notes`
    # changes as the study does; this does not, which is why the two
    # are kept apart rather than run together. Write one string, or a
    # list of lines as here — a single string with "\n" in it works
    # too, and is harder to read in a file someone has to maintain.
    comment = [
      "Settings checked against issue D of the fault study.",
      "Source impedance assumed 250 MVA at the 11 kV board.",
      "Queries to M. Haugen, protection team.",
    ];
  };

  # Axis furniture, kept recessive so the curves carry the eye.
  axes = {
    color = "#333333";
    grid_color = "#d8d8d8";
    label_color = "#444444";
    label_size_px = 11;
    tick_size_px = 9;
    frame = true;
    mirror = false;
  };

  curves = {
    palette = "grayscale";
    line_width_px = 2.0;
    auto_color = true;
  };

  points = {
    color = "#111111";
    shape = "circle";
    size_px = 9;
    outline = true;
  };

  leaders = {
    show = true;
    style = "dot";
    width_px = 0.9;
    color = "#666666";
    label_offset_px = 12;
  };

  faults = {
    style = "dotted";
    color = "#555555";
    width_px = 1.2;
    labels = true; # draw the names under the axis at all
    # Each name is captioned with its current — the figure the rule is
    # drawn for. Turn this off where a dozen conditions at similar
    # currents would make a band of numbers and the legend already
    # quotes them.
    currents = true;
  };
  times  = {
    style = "dashed";
    color = "#333333";
    width_px = 1.4;
    labels = true;
  };

  scale  = {
    auto = true;
    tick_density = "dense";
  };

  # `[meta.*]`, `[page]` and `[of]` macros are substituted at render.
  title = {
    text = "[meta.project] — [meta.study]";
    subtitle = "Drawing [meta.drawing] for [meta.client]";
    align = "left";
    color = "#000000";
    font_size_px = 15;
  };

  footer = {
    left = "[meta.drawing] rev [meta.revision]";
    center = "[meta.engineer] · [meta.date]";
    right = "[meta.drawing] · sheet [page] of [of]";
    font_size_px = 8;
    color = "#555555";
    border = true;
  };

  watermark = "UNISSUED — FOR COMMENT";
}

view {
  voltage = MV;
  quantity = any;
  stages = individual; # draw each stage, not the composite
  current_min = 200 A;
  current_max = 40 kA;
  time_min = 20 ms;
  time_max = 100 s;
}
