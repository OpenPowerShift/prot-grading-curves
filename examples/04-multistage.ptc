# Sample 04 — Multi-stage element (composite IDMT + instantaneous)
#
# One element with two stages: an IEC SI inverse-time stage for the
# slow trip + a definite-time stage for the high-set instantaneous.
# The renderer draws a separate visible curve per stage (or the
# pointwise-min composite, whichever `view.stages` is set to).
#
# In the playground, press ? (or Ctrl-Space) for completions: on a blank
# line it lists what the enclosing block accepts, and after an `=` it
# lists that field's values -- curve names, quantities, declared
# conditions and voltage levels included.

meta {
  project = "Multi-stage demo";
}

system {
  voltages {
    MV {
      V = 11.0 kV;
    }
  }
}

faults {
  BUS_FAULT {
    name = "Bus fault";
    I = 6000 A;
  }
  REMOTE_FAULT {
    name = "Remote fault";
    I = 1200 A;
  }
}

relay R_TGT {
  voltage = MV;
  ct_ratio = 600/5;

  element 51 {
    function = "phase_oc";
    stages {
      stage main {
        curve = iec.si;
        I_pickup = 400 A;
        tms = 0.35;
      }
      # A stage can stop before the element that owns it.
      #
      # This high-set is blocked above the maximum through-fault the
      # board can deliver, so drawing it further right would show an
      # instantaneous trip at a current that cannot flow. Without a
      # ceiling of its own a stage takes the element's, and without
      # either it runs to the edge of the sheet.
      #
      # Its own ink too: a high-set is read as a shelf rather than a
      # characteristic, and dashing it says so at a glance.
      stage inst {
        curve = definite;
        I_pickup = 4500 A;
        t_delay = 0.08 s;
        I_cutoff = 6000 A;
        style = dashed;
      }
    }
  }
}

page {
  # One relay, one composite curve: A5 is a page in a report.
  size = "A5";
  # `column` is the default gutter; stated here so the
  # alternatives (inside / direct / none) have something to read against.
  legend = {
    style = "column";
  };
  theme = "light";
  title = "Multi-stage element (composite view)";
}

view {
  stages = "composite";
}
