# Sample 05 — Transformer protection: inrush, damage, and grading
#
# A 25 MVA 33/11 kV transformer with HV incomer protection graded
# against an LV feeder. The study has to satisfy three constraints at
# once, which is what makes transformer protection awkward:
#
#   1. clear the LV feeder's backup duty with adequate margin,
#   2. sit ABOVE the inrush point, or the transformer trips whenever
#      it is energised,
#   3. sit BELOW the through-fault damage curve, or the transformer is
#      not protected against the damage the curve describes.
#
# In the playground, press ? (or Ctrl-Space) for completions: on a blank
# line it lists what the enclosing block accepts, and after an `=` it
# lists that field's values -- curve names, quantities, declared
# conditions and voltage levels included.

meta {
    project  = "Transformer inrush and damage";
    engineer = "A. Cooper";
    date     = "2026-07-28";
    standard  = ["IEC_60255_151", "IEEE_C57.109"];
    margin = 0.30 s;
}

system {
    voltages {
        "HV" {
            V           = 33.0 kV;
            description = "33 kV incomer";
        }
        "LV" {
            V           = 11.0 kV;
            description = "11 kV feeders";
        }
    }
    base_S = 25.0 MVA;
}

faults {
    "LV max" {
        I       = 6.40 kA;
        voltage = "LV";
    }
    "LV min" {
        I       = 2.50 kA;
        voltage = "LV";
    }
    "HV max" {
        I       = 18.4 kA;
        voltage = "HV";
    }
}

# ---- transformer characteristic points -------------------------------
#      25 MVA at 33 kV  ->  I_FLC = 25e6 / (sqrt(3) x 33e3) = 437 A
#      Inrush is conventionally 12 x FLC held for 0.1 s.
point "TX1_inrush" {
    I       = 5250 A;
    t       = 0.10 s;
    voltage = "HV";
    label   = "TX1 inrush — 12 x FLC";
    shape   = "cross";
    coords  = true; # append (current, time) to the label
}

#      IEEE C57.109 category II through-fault: 2 s at 25 x FLC.
point "TX1_damage" {
    I       = 10900 A;
    t       = 2.0 s;
    voltage = "HV";
    label   = "TX1 through-fault limit";
    shape   = "triangle";
    coords  = true;
}

relay R_TRF_HV {
    voltage  = "HV";
    maker    = "ABB";
    model    = "REF615";
    ct_ratio = 600/5;

    element 51 {
        function = "phase_oc";
        curve    = iec.si;
        I_pickup = 720 A;
        tms      = 0.30;
    }
}

relay R_FDR_LV {
    voltage  = "LV";
    maker    = "Schneider";
    model    = "MiCOM_P122";
    ct_ratio = 400/5;

    element 51 {
        function = "phase_oc";
        curve    = iec.vi;
        I_pickup = 480 A;
        tms      = 0.25;
    }
    element 50 {
        function = "phase_oc";
        curve    = definite;
        I_pickup = 3200 A;
        t_delay  = 0.05 s;
    }
}

grade {
    primary  = R_FDR_LV:51;
    backup   = R_TRF_HV:51;
    fault    = "LV max";
    margin   = 0.30 s;
    upstream = true; # verify the margin holds above the fault too
}

# ---- annotate the grading margins on the plot ------------------------
#      A margin annotation draws the vertical gap between two curves at
#      a fault current and labels it, so the number the coordination
#      argument turns on is on the chart, not just in the report.
annotate {
    primary = R_FDR_LV:51;
    backup  = R_TRF_HV:51;
    fault   = "LV max";
    label   = "CTI";
}

annotate {
    primary = R_FDR_LV:51;
    backup  = R_TRF_HV:51;
    fault   = "LV min";
    label   = "CTI";
}

page {
    size        = "A4";
    orientation = "landscape";
    theme       = "light";
    border      = true;
    title       = {
        text     = "25 MVA 33/11 kV — transformer protection";
        subtitle = "Inrush, through-fault withstand, and feeder grading";
    };
}

view {
    voltage     = "HV";
    current_pad = 0.25;
}
