# Sample 07 — Grading that fails further up the curve
#
# This study passes at the declared fault and fails anyway. The feeder
# uses a standard-inverse characteristic and the incomer an extremely
# inverse one, so the two curves converge as current rises: above about
# 12 kA the *backup* becomes faster than the *primary*, and an incomer
# trip would take out the whole board for a feeder fault.
#
# Checking only the declared fault current cannot see this. The upstream
# sweep is what surfaces it, and it runs by default — write
# `upstream = false;` in the grade below and watch the study go green
# while remaining wrong. That is what this check is worth, and it is why
# it is no longer something you have to know to ask for.
#
# In the playground, press ? (or Ctrl-Space) for completions: on a blank
# line it lists what the enclosing block accepts, and after an `=` it
# lists that field's values -- curve names, quantities, declared
# conditions and voltage levels included.

meta {
  project = "Mis-coordination demo";
  engineer = "A. Cooper";
  date = "2026-07-28";
  margin = 0.30 s;
}

system {
  voltages {
    MV {
      V = 11.0 kV;
    }
  }
}

faults {
  BUS_FAULT {
    name = "Bus fault";
    I = 3.0 kA;
  }
  MAX_FAULT {
    name = "Max fault";
    I = 20.0 kA;
  }
}

relay R_FEEDER {
  voltage = MV;
  maker = "GE";
  model = "UR T60";
  ct_ratio = 400/5;

  element 51 {
    function = "phase_oc";
    curve = iec.si; # standard inverse — shallow
    I_pickup = 300 A;
    tms = 0.20;
  }
}

relay R_INCOMER {
  voltage = MV;
  maker = "GE";
  model = "UR T60";
  ct_ratio = 600/5;

  element 51 {
    function = "phase_oc";
    curve = iec.ei; # extremely inverse — steep
    I_pickup = 500 A;
    tms = 0.40;
  }
}

grade {
  primary = R_FEEDER:51;
  backup = R_INCOMER:51;
  fault = BUS_FAULT;
  margin = 0.30 s;

  # Left in, though it is now the default, because this study is about
  # the sweep and the reader should see the name of the thing being
  # demonstrated. `upstream = false` turns it off for a pair that
  # cannot be driven above its fault — see sample 10's spur fuse.
  upstream = true;
}

page {
  size = "A4";
  orientation = "landscape";
  # Dark, for reading on a screen in a substation at night.
  theme = "dark";
  border = true;
  title       = {
    text = "Curve families that converge";
    subtitle = "IEC SI feeder against an IEC EI incomer";
  };
}

view {
  current_pad = 0.25;
}
