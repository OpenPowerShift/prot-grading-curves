# Sample 03 — ANSI MI + IEC VI mix across voltages
#
# A North-American utility study deliberately mixing curve families
# (ANSI moderately inverse on the LV feeder, IEC very inverse on
# the HV incomer) so the engineer can see normalised TCC curves line
# up at M=1.
#
# In the playground, press ? (or Ctrl-Space) for completions: on a blank
# line it lists what the enclosing block accepts, and after an `=` it
# lists that field's values -- curve names, quantities, declared
# conditions and voltage levels included.

meta {
  project = "Cross-vendor study";
  standard = ["IEEE_C37_112", "IEC_60255_151"];
}

system {
  voltages {
    "HV" {
      V = 115.0 kV;
    }
    "LV" {
      V = 12.47 kV;
    }
  }
}

faults {
  "LV 3ph" {
    I = 5500 A;
    voltage = "LV";
  }
  "HV 3ph" {
    I = 12000 A;
    voltage = "HV";
  }
}

relay R_FDR {
  voltage = "LV";
  maker = "GE";
  model = "UR T60";
  ct_ratio = 1200/5;

  element 51 {
    curve = ansi.mi;
    I_pickup = 480 A;
    tms = 0.50;
  }
}

relay R_INC {
  voltage = "HV";
  maker = "ABB";
  model = "REL-615";
  ct_ratio = 1200/5;

  element 51 {
    curve = iec.vi;
    I_pickup = 600 A;
    tms = 0.35;
  }
}

grade {
  primary = R_FDR:51;
  backup = R_INC:51;
  fault = "LV 3ph";
  margin_target = 0.35 s;
}

page {
  size = "A4";
  theme = "light";
  title = "Cross-vendor TCC comparison";
}
