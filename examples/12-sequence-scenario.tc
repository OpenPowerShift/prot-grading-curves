# Sample 12 — Sequence currents: what each relay actually measures
#
# A relay does not measure "the fault current". A 51 measures phase
# current, a 51G measures the residual 3*I0 its CT connection presents,
# a 46 measures negative sequence. Those are three different numbers at
# one fault, so each element has to be evaluated against its own.
#
#   element 51  { function = "phase_oc";    }             # -> phase
#   element 51G { function = "earth_fault"; }             # -> 3*I0
#   element 46  { function = "neg_seq"; measures = "I2"; } # -> I2
#
# `neg_seq` has no default: IEDs differ over whether the pickup is
# scaled in I2 or 3*I2, and the factor of three decides whether the
# element operates at all. It must be stated.
#
# ---- Why a `scenario` and not a `fault` ---------------------------------
#
# A `fault` is one current at one level. Referring it to another level
# by the turns ratio is right for phase current, and for positive and
# negative sequence — but ZERO SEQUENCE DOES NOT CROSS A DELTA WINDING.
# There is no ratio that carries it.
#
# A `scenario` declares the same condition wherever it is measured, so
# nothing has to be transformed. The figures come from the fault study;
# the processor selects rather than derives.
#
# The study below is a delta-star transformer with an earth fault on the
# star side. Note `I0_A = 0` at HV: that is the delta blocking zero
# sequence, and it is why
#
#   * the HV *residual* element (51G) is blind to this fault, and
#   * the HV *negative-sequence* element (46) is what backs it up.
#
# Grade both pairs and the report shows exactly that.
#
# In the playground, press ? (or Ctrl-Space) for completions: on a blank
# line it lists what the enclosing block accepts, and after an `=` it
# lists that field's values -- curve names, quantities, declared
# conditions and voltage levels included.

meta {
    project   = "Sequence currents";
    study     = "LV earth fault behind a delta-star transformer";
    engineer  = "A. Cooper";
    date      = "2026-07-30";
    revision  = "A";
    CTI_min_s = 0.30;
}

system {
    voltages {
        "HV" { kV = 33.0;  description = "33 kV, delta winding"; }
        "LV" { kV = 0.48;  description = "480 V, star, earthed"; }
    }
    frequency_Hz = 50;
    grounding    = "low_impedance";

    # Whether zero sequence reaches the other level depends on the
    # windings, so the study says. This transformer is delta on the HV
    # side, which blocks it -- and that is the whole reason the HV
    # residual element below is blind to an LV earth fault.
    #
    # A star-star transformer with both neutrals earthed would be
    # `continuous`, and the residual would refer by the turns ratio.
    zero_sequence {
        "HV" to "LV" = blocked;
    }
}

# ---- The condition, at every level it is measured. ---------------------
#      For a single-phase-to-earth fault on the star side the LV
#      components are equal (I1 = I2 = I0 = If/3). On the delta side the
#      zero sequence is absent, and what remains reads as an unbalance
#      carrying negative sequence.
scenario "LV earth fault" {
    type        = single_phase_earth;
    description = "Single phase to earth at 0.48 kV, system normal";

    level "LV" { I_A = 460 A; I1_A = 153 A; I2_A = 153 A; I0_A = 153 A; }
    level "HV" { I_A = 3.9 A; I1_A = 2.2 A; I2_A = 2.2 A;  I0_A = 0 A;  }
}

# A second condition for the phase elements: a solid three-phase fault
# on the LV side, which is balanced and so carries no I2 or I0 at all.
scenario "LV three-phase fault" {
    type        = three_phase;
    description = "Balanced 3ph at 0.48 kV";

    level "LV" { I_A = 520 A; I1_A = 520 A; I2_A = 0 A; I0_A = 0 A; }
    level "HV" { I_A = 7.6 A; I1_A = 7.6 A; I2_A = 0 A; I0_A = 0 A; }
}

# ---- Nothing else is needed to mark them. -----------------------------
#      A scenario draws its own vertical rule, at ITS OWN FIGURE FOR THE
#      LEVEL THE SHEET IS IN -- 2.2 A of I2 on the HV sheet below, 153 A
#      on an LV one. Nothing is referred across the transformer, which is
#      the whole reason to write a scenario instead of a `faults` entry.
#
#      A scenario silent about the level being drawn, or carrying none of
#      the quantity on the axis, gets no rule and says so in the legend:
#      "LV three-phase fault carries no I2 at HV" is the balanced
#      condition, which has no negative sequence at all.
#
#      `faults { ... }` still works and the two can share a sheet; a
#      fault is one current at one level, referred by the turns ratio.

# ---- Downstream: the LV air circuit breaker. ---------------------------
relay R_ACB {
    name     = "LV ACB";
    voltage  = "LV";
    ct_ratio = 1/1;

    element 51 {
        name     = "Phase OC";
        function = "phase_oc";
        curve    = iec.si;
        I_pu     = 300 A;
        tms      = 0.10;
    }
}

# ---- Upstream: the HV relay, three elements measuring three currents. --
relay R_850 {
    name     = "HV relay (GE Multilin 850)";
    maker    = "GE Multilin";
    model    = "850";
    voltage  = "HV";
    ct_ratio = 250/1;

    element 51 {
        name     = "Phase TOC (51)";
        function = "phase_oc";              # measures phase current
        curve    = iec.si;
        I_pu     = 4.2 A;
        tms      = 0.20;
    }

    element 51G {
        name     = "Ground TOC (51G)";
        function = "earth_fault";           # measures residual 3*I0
        curve    = iec.si;
        I_pu     = 0.8 A;
        tms      = 0.15;
    }

    element 46 {
        name     = "Negative Sequence (46)";
        function = "neg_seq";
        measures = "I2";                    # this IED is scaled in I2
        curve    = definite;
        I_pu     = 1.5 A;
        t_delay  = 2.00 s;      # slower than the ACB's 1.63 s at this fault
    }
}

# ---- Upstream: the feeder relay's own I2 backup. ----------------------
#      Two negative-sequence elements grade against each other, which is
#      what the sheet below actually plots.
relay R_FDR {
    name     = "33 kV feeder (SEL-751)";
    maker    = "SEL";
    model    = "751";
    voltage  = "HV";
    ct_ratio = 250/1;

    element 46 {
        name     = "Neg Seq backup (46)";
        function = "neg_seq";
        measures = I2;                      # unquoted spelling works too
        curve    = definite;
        I_pu     = 1.5 A;
        t_delay  = 2.60 s;                  # 0.6 s above the 850
    }
}

# ---- I2 grading: the 850 against the feeder relay. --------------------
grade {
    primary   = R_850:46;
    backup    = R_FDR:46;
    scenario  = "LV earth fault";
    CTI_min_s = 0.30;
    comment   = "both measure I2, so this is a like-for-like margin";
}

# ---- The negative-sequence element does the backing up. ---------------
grade {
    primary   = R_ACB:51;
    backup    = R_850:46;
    scenario  = "LV earth fault";
    CTI_min_s = 0.30;
    comment   = "I2 backup for an LV earth fault the HV residual cannot see";
}

# ---- The residual element cannot: 3 x 0 = 0 at HV. --------------------
#      The report says NO_OPERATION, which is the correct physical
#      answer rather than a margin computed off the wrong current.
grade {
    primary   = R_ACB:51;
    backup    = R_850:51G;
    scenario  = "LV earth fault";
    CTI_min_s = 0.30;
    comment   = "blind to this fault -- zero sequence stays in the delta";
}

# ---- Phase grading, on the balanced condition. ------------------------
grade {
    primary   = R_ACB:51;
    backup    = R_850:51;
    scenario  = "LV three-phase fault";
    CTI_min_s = 0.30;
}

# ---- Putting the margin on the drawing. --------------------------------
#      The annotation reads each side in ITS OWN frame, taking the
#      scenario's figure for that level -- the 850's I2 at HV, the ACB's
#      at LV -- so the figure drawn is the one the report computes.
#
#      Name several conditions and the margin is drawn once for each, at
#      each one's own current. `scenario = "..."`, `scenarios = [...]`,
#      `fault = "..."` and `faults = [...]` are all the same key: a
#      condition, one or several.
annotate {
    primary   = R_850:46;
    backup    = R_FDR:46;
    scenario  = "LV earth fault";
    label     = "CTI";
}

# ---- A marked point at a condition's current. --------------------------
#      A point normally states its own `I_A`. Naming a condition takes
#      the current from the study instead, at the quantity the sheet is
#      drawn against -- so this marker moves with the fault study rather
#      than having to be edited alongside it.
#
#      This one is on the 850's own level and own quantity, so it lands
#      exactly on that element's curve: 2.2 A of I2 at HV, cleared by its
#      2.00 s definite-time stage. A marker taken from a level other than
#      the one drawn is carried here by the turns ratio, which for a
#      scenario is NOT the same as its declared figure for this level --
#      see the note in the guide.
point "850 negative-sequence trip" {
    scenario = "LV earth fault";
    voltage  = "HV";
    t_s      = 2.00 s;
    label    = "850 46 operates";
    shape    = square;
}

page {
    size        = "A4";
    orientation = "landscape";
    theme       = "light";
    border      = true;
    legend      = { title = "Elements"; };
    title       = { text     = "Sequence currents — what each relay measures";
                    subtitle = "LV earth fault behind a delta-star transformer"; };
}

# ---- Which current the sheet is drawn against. ------------------------
#      A TCC has one x axis, so it has one quantity. This sheet is a
#      NEGATIVE-SEQUENCE sheet: the two 46 elements are plotted against
#      I2, the fault rules stand at each condition's I2, and the axis
#      title says so.
#
#      Change `quantity` to see the other sheets of the same study:
#
#        quantity = any;     everything on one current axis (the default)
#        quantity = phase;   ordinary phase grading
#        quantity = 3I0;     residual current
#        quantity = I2;      negative sequence (this sheet)
#
#      `condition` names what the sheet depicts -- a fault or a scenario.
#      With it, curves measuring something else are CONVERTED onto the
#      axis using that condition's own numbers: the HV 51 measures phase
#      current and appears here at 3.9 / 2.2 = 1.77 times its own pickup,
#      the ratio this condition actually declares. Where a component is
#      not declared the fault type supplies it (a phase-earth fault would
#      give 3), and a declared figure always wins -- which is how the
#      delta's effect on this side gets into the drawing.
#
#      Elements the condition cannot operate are suppressed rather than
#      drawn where they never could: the 51G is absent from this sheet
#      because I0 = 0 at HV. Drop `condition` and the sheet falls back to
#      showing only what measures I2.
view {
    voltage     = "HV";
    quantity    = I2;
    condition   = "LV earth fault";
    current_min = 0.5 A;
    current_max = 50 A;
    time_min    = 20 ms;
    time_max    = 100 s;
}
