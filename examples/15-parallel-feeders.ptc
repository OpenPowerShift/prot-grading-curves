# Sample 15 — Parallel feeders: current share, and the solver
#
# Two feeders running in parallel to one load do not each see the whole
# fault current. A fault out on the load side is fed from both ends, so
# each relay measures roughly half of it — and a relay graded against
# the full figure is graded against a current it never sees.
#
# Two things in this study exist for that:
#
#   share       what fraction of a condition's current this element
#               carries, in percent
#   solve       let the tool pick a setting to hit a stated margin,
#               instead of guessing and re-running
#
# A parallel pair also needs DIRECTIONAL elements, or a fault on one
# circuit trips the healthy one. That is a real constraint and this
# tool does not model it: directionality is not a time-current
# property, so there is nothing for a TCC to draw. `direction`,
# `directional` and `char_angle` were accepted and silently ignored
# until 2026-08-08; record such settings in `description` or in the
# page's `notes`.
#
# Press ? after `free =` to see what the solver may vary, and after
# `strategy =` for how tightly it should land.

meta {
  project = "Ardmore 33 kV double circuit";
  study = "Parallel feeder grading with a solved backup";
  engineer = "L. Vasquez";
  date = "2026-08-01";
  revision = "B";
  margin = 0.35 s;
}

system {
  voltages {
    HV {
      V = 33.0 kV;
      description = "33 kV double circuit";
    }
  }
  I_base = 500 A;
  I_units = "primary";
}

faults {
  LOAD_END_3PH {
    name = "Load end 3ph";
    I = 7.2 kA;
    type = three_phase;
    voltage = HV;
  }
  LOAD_END_2PH {
    name = "Load end 2ph";
    I = 6.2 kA;
    type = two_phase;
    voltage = HV;
  }
  LOAD_END_2PHE {
    name = "Load end 2phE";
    I = 5.8 kA;
    type = two_phase_earth;
    voltage = HV;
    I2 = 2.1 kA;
    I0 = 1.4 kA;
    residual = 4.2 kA;
  }
}

# ---- The condition, and who carries what. ----------------------------
#      `sees` records the share each relay takes of the level's current.
#      Written down, it is auditable; left to the reader, it is the
#      commonest place a parallel study goes wrong by a factor of two.
scenario BOTH_CIRCUITS_IN {
  name = "Both circuits in";
  type = three_phase;
  description = "Normal running, both feeders closed";

  level HV {
    I = 7.2 kA;
    I1 = 7.2 kA;
    I2 = 0 A;
    I0 = 0 A;
  }

  sees R_FDR_A {
    share = 50;
  }
  sees R_FDR_B {
    share = 50;
  }
}

scenario ONE_CIRCUIT_OUT {
  name = "One circuit out";
  type = three_phase;
  description = "B out for maintenance; A carries the lot";

  level HV {
    I = 6.4 kA;
    I1 = 6.4 kA;
    I2 = 0 A;
    I0 = 0 A;
  }

  sees R_FDR_A {
    share = 100;
  }
}

# ---- Feeder A: looks down the line. ----------------------------------
relay R_FDR_A {
  name = "Feeder A";
  maker = "SEL";
  model = "751";
  reference = "Ardmore panel A";
  voltage = HV;
  ct_ratio = 400/5;

  element 51 {
    name = "Phase TOC";
    function = "phase_oc";
    curve = ansi.mi;
    I_pickup = 480 A;
    tms = 1.0;

    # No `share` here.
    #
    # This relay's share is stated per *condition* by the `sees` blocks
    # above -- 50% with both circuits in, 100% with one out -- and that
    # is the more specific claim, so it wins. An `element { share }` as
    # well would be a second answer to the same question: they used to
    # multiply, grading this pair at a quarter of the level current
    # while the report printed the half beside it. Declaring both is
    # now `SHARE_DECLARED_TWICE`.
    #
    # Use `element { share }` where the split is a property of the
    # installation rather than of a condition -- two identical feeders
    # off one board, graded against a plain `fault`.

  }
}

# ---- Feeder B: identical plant, same setting. ------------------------
relay R_FDR_B {
  name = "Feeder B";
  maker = "SEL";
  model = "751";
  voltage = HV;
  ct_ratio = 400/5;

  element 51 {
    name = "Phase TOC";
    function = "phase_oc";
    curve = ansi.mi;
    I_pickup = 480 A;
    tms = 1.0;
    # Its share is stated by the `sees` blocks too.
  }
}

# ---- The source-end backup: sees the whole fault. ---------------------
relay R_SRC {
  name = "Source incomer";
  maker = "ABB";
  model = "REF615";
  voltage = HV;
  ct_ratio = 800/5;

  element 51 {
    name = "Phase TOC";
    function = "phase_oc";
    curve = ansi.mi;
    I_pickup = 900 A;
    tms = 2.0;
  }
}

# ---- The bus-zone backup. --------------------------------------------
#      In the real scheme this element looks the other way; on a TCC it
#      is simply another characteristic, drawn and graded on its times.
relay R_BUS {
  name = "Bus zone backup";
  voltage = HV;
  ct_ratio = 800/5;

  element 51 {
    name = "Reverse-looking TOC";
    function = "phase_oc";
    curve = ansi.vi;
    I_pickup = 1.2 kA;
    tms = 3.0;
  }
}

# ---- Grading, with the source relay's dial computed. -----------------
#      `solve` APPLIES the setting it computes: the curve is drawn at
#      the solved dial and the margins come from it. A dial already in
#      the file is superseded, not discarded -- the legend shows both
#      and the report warns which governs.
#
#        free     = [tms] | [t_delay] | [I_pickup]  what may change
#        strategy = tight | loose | safety_factor
#
#      `tight` lands as close above the target as the dial steps allow;
#      `loose` leaves headroom; `safety_factor` multiplies the target.
grade {
  primary = R_FDR_A:51;
  backup = R_SRC:51;
  scenario = BOTH_CIRCUITS_IN;
  margin = 0.35 s;
  margin_target = 0.40 s;
  comment = "A carries half; the source relay sees the whole fault";

  solve {
    strategy = loose;
    free          = [tms];
    tolerance_pct = 5;
    comment = "dial the source relay to clear the grading";
  }
}

# The same relay, the same dial, a second condition to satisfy.
#
# R_SRC has ONE time multiplier and both of these grades want a say in
# it. Which one wins is not a matter of which is written first: operate
# time rises with tms at every current, and a margin is a floor, so the
# LARGEST tms any condition asks for satisfies all of them. That is the
# governing constraint, and it is what an engineer picks by hand.
#
# Here "both circuits in" needs 1.350 and this one needs less, so this
# solve is reported as SOLVE_SUPERSEDED — naming the condition that
# governs and the dial it set. Both grades are then reported against
# that dial, which is the one drawn.
grade {
  primary = R_FDR_A:51;
  backup = R_SRC:51;
  scenario = ONE_CIRCUIT_OUT;
  margin = 0.35 s;
  comment = "worst case for A: it now carries everything";

  solve {
    strategy = loose;
    free = [tms];
    comment = "the same dial, asked for by the other condition too";
  }
}

annotate {
  primary = R_FDR_A:51;
  backup = R_SRC:51;
  scenario = BOTH_CIRCUITS_IN;
  label = "CTI, both in";
}

# ---- Two sheets from one study. --------------------------------------
#      `default = true` picks the one the CLI and a fresh playground
#      open on; the picker offers the rest.
view PRIMARY_AMPS {
  name = "Primary amps";
  default = true;
  voltage = HV;
  quantity = phase;
  condition = BOTH_CIRCUITS_IN;
  title = "Parallel feeder grading";
  subtitle = "Both circuits in service, 50% share each";
  axis = "primary";

  # A and B are identical plant with identical settings, so they draw
  # at the same pixels: one line on the sheet and two entries in the
  # legend, with no way to tell whether the second is hidden, missing
  # or was never drawn. Coincident curves are pulled apart by default;
  # 4 px rather than 3 because these two run together for the whole
  # sheet and there is nothing else nearby to crowd. The notes say it
  # was done, and to which curves.
  nudge_px = 4;

  current_min = 100 A;
  current_max = 30 kA;
  time_min = 20 ms;
  time_max = 100 s;
}

view MULTIPLES_OF_PICKUP {
  name = "Multiples of pickup";
  voltage = HV;
  quantity = phase;
  condition = ONE_CIRCUIT_OUT;
  title = "Same study, drawn in multiples";
  subtitle = "x pickup rather than amps — how a settings sheet reads";

  # `multiples` draws the abscissa as x-pickup instead of amps, which
  # is how a relay manual states its curves. One axis carries one
  # scale, so it is anchored to ONE curve's pickup -- named here, or
  # else the highest on the sheet -- and every curve still computes
  # against its own.
  axis = "multiples";
  reference_ct = R_FDR_A:51;

  current_min = 100 A;
  current_max = 30 kA;
  time_min = 20 ms;
  time_max = 100 s;
}

page {
  size = "A4";
  orientation = "landscape";
  theme = "light";
  border = true;
  legend      = {
    title = "Feeders";
    position = "bottom_right";
    swatch = "box";
    currents = "both";
  };
  curves      = {
    palette = "high_contrast";
    auto_color = true;
  };
  leaders     = {
    style = "arrow";
    color = "#555555";
    label_offset_px = 14;
  };
  footer      = {
    left = "[meta.project]";
    center = "[meta.study]";
    right = "Rev [meta.revision] · [meta.date]";
    font_size_px = 9;
  };
}
